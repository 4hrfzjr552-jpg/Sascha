{
  "manifest_version": 3,
  "name": "Sascha AI -> Vinted Assistant",
  "version": "3.17.0",
  "description": "Katalogbasierte Übertragung geprüfter Vinted-Entwürfe aus Sascha AI (ohne Veröffentlichung).",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://www.vinted.de/*",
    "https://www.vinted.at/*",
    "https://*.vercel.app/*",
    "https://sascha-omega.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sascha AI -> Vinted"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.vercel.app/*",
        "https://sascha-omega.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content-sascha.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.vinted.de/*",
        "https://www.vinted.at/*"
      ],
      "js": [
        "vinted-catalog-v3.js",
        "vinted-size-estimate.js",
        "vinted-image-edit.js",
        "content-vinted-v3.js"
      ],
      "run_at": "document_end"
    }
  ]
}
